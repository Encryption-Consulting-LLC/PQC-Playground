# EC-PKI-Playground backend configuration
# Copy this file to .env and fill in the values for your deploy.
#
# Login is always required — there is no anonymous mode. Every visitor signs
# in with an account (identity is decoupled from the ESXi target):
#   - Username/password (POST /auth/login; bootstrap the first accounts with
#     uv run create-admin <name> [--role admin|operator|guest]). Guests sign
#     in exclusively this way.
#   - Employee SSO (OIDC_* vars below).
# The account's role (admin/operator/guest) decides the feature set: admin
# runs the /admin console (accounts, ESXi target, base images), operator
# builds and deploys on the canvas, guest gets a restricted subset of that.

# Example guest account, seeded into the users collection at startup if absent
# (idempotent — never overwrites an existing account). Gives a fresh deploy a
# working username/password login out of the box. Change these for any real
# deploy; set the password empty to skip seeding entirely.
# EXAMPLE_GUEST_USERNAME=guest
# EXAMPLE_GUEST_PASSWORD=guest-playground

# Required in BOTH the API and Celery worker processes.
# Generate each with: openssl rand -base64 32
# SESSION_SECRET=
# SETTINGS_ENC_KEY=

# First-boot seed for the shared org-wide ESXi target. Written into the Mongo
# settings document if absent there; afterwards the document is authoritative
# and operator-editable via PUT /api/settings without a restart. Optional at
# boot — VM routes 503 until it's configured.
# ESXI_HOST=192.168.100.10
# ESXI_USER=root
# ESXI_PASSWORD=changeme
# ESXI_PORT=443

# Windows Server golden image used by guided deploys. These values seed the
# shared settings document once; operators can change and validate them later.
# CLONE_BASE=ws-2025-base
# CLONE_DATASTORE=datastore1
# CLONE_GUEST_OS=windows2022srvNext-64
# CLONE_NETWORK=VM Network
# CLONE_MAX_USAGE_PCT=80
# The image's own built-in Administrator password, from before it was sysprepped.
# Every Windows guest but a domain controller keeps it (first boot re-asserts it),
# so it is the credential remote desktop signs those guests in with. Seed only —
# admin-editable at Infrastructure -> Image afterwards. Empty disables remote
# desktop on those guests and changes nothing else.
# CLONE_ADMIN_PASSWORD=

# First-boot seed for the guest subnet — same seed-only semantics
# as ESXI_*; operator-editable via PUT /api/settings afterwards (edits reseed
# the IP pool live). Every real deploy-plan clone claims an address from the
# inclusive GUEST_IP_START..GUEST_IP_END range and bakes it into the VM's
# firstboot ISO; teardown (DELETE /api/vm/{name}) returns it to the pool.
# The range must exclude the network, broadcast, and gateway addresses.
# Deploys are rejected (422) until start/end/gateway/dns1 are all configured.
# GUEST_IP_START=192.168.100.50
# GUEST_IP_END=192.168.100.199
# GUEST_PREFIX=24
# GUEST_GATEWAY=192.168.100.1
# GUEST_DNS1=192.168.100.2
# GUEST_DNS2=
# GUEST_DNS_SUFFIX=pki.lab
# Sanity cap on how many addresses the guest range may span (one ip_pool
# document is seeded per address). Default 8192; raise it for larger subnets.
# GUEST_POOL_MAX_SIZE=8192

# Employee SSO — generic OIDC code flow (Keycloak and Azure AD both fit).
# Enabled only when issuer, client id/secret, and redirect URI are all set.
# IdP groups map to roles via the two *_GROUPS lists (comma-separated, exact
# string match against the OIDC_GROUP_CLAIM claim); users matching no group
# are rejected.
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:5173/
# OIDC_GROUP_CLAIM=groups
# OIDC_OPERATOR_GROUPS=
# OIDC_GUEST_GROUPS=

# MongoDB — system of record for projects / VM registry / IP pool / settings
# doc / users. The app fails fast at startup if it can't reach it. Run one
# locally with:
#   docker run -d --name pki-mongo -p 27017:27017 -v pki-mongo-data:/data/db mongo:8
# MONGO_URL=mongodb://localhost:27017
# MONGO_DB=pki_playground

# Valkey/Redis — Celery broker, result backend, and the job pub/sub bus the
# progress WebSockets read from.
# VALKEY_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Per-queue worker concurrency, consumed by the `uv run worker` launcher
# (which runs two worker processes: one for the `esxi` queue, one for the
# `provision` queue). CLONE_CONCURRENCY caps the esxi queue — the global
# ceiling on simultaneous clones/destroys against the shared ESXi host.
# PROVISION_CONCURRENCY caps the provision queue, whose ops mostly sleep
# waiting on guest agents, so it can be far higher. Defaults: 3 / 16.
# CLONE_CONCURRENCY=3
# PROVISION_CONCURRENCY=16

# Executor agent bundling. BACKEND_PUBLIC_URL is required to embed the
# pki-executor agent into every firstboot ISO so deployed VMs phone home.
# EXECUTOR_AGENT_PATH defaults to this repo's backend/agent/pki-executor.exe
# when present; override it only when the API/worker use a different shared path.
# The same file must be readable at this path on the API host (preflight) and
# worker host (bundling). If no bundled or configured file exists, firstboot
# stays agent-free.
#   EXECUTOR_AGENT_PATH — API/worker-host path to the agent binary.
#   BACKEND_PUBLIC_URL — browser-facing origin; also the default target baked
#     into the agent's executor.toml as [backend] url. For VMs that can't
#     reach the backend directly, point this at a Cloudflare tunnel (cloudflared
#     proxies the WebSocket at {BACKEND_PUBLIC_URL}/api/executor/connect).
#   AGENT_BACKEND_URL — optional override for the origin baked into the agent's
#     executor.toml, decoupling the phone-home target from the browser URL.
#     Guest VMs share the backend's LAN, so pointing agents straight at the LAN
#     backend avoids routing phone-home out to the public FQDN and back. Unset →
#     agents fall back to BACKEND_PUBLIC_URL. Caveat: the agent validates TLS
#     against public webpki-roots, so a private-IP target behind a self-signed
#     cert needs a plain http:// (→ ws://) URL, not https://.
# EXECUTOR_AGENT_PATH=/opt/pki-playground/agent/pki-executor.exe
# BACKEND_PUBLIC_URL=https://pqc-playground.encryptionconsulting.com/
# AGENT_BACKEND_URL=http://192.168.180.1:8000

# How long (seconds) the clone worker waits for a freshly-booted VM's agent to
# phone home before failing the provision op. Role/feature installs run as
# dispatched steps after phone-home (not in firstboot), so a healthy VM connects
# within minutes; this is the ceiling for a slow boot. Default 2700 (45 min).
# AGENT_PHONE_HOME_TIMEOUT_S=2700

# LEGACY-AGENT FALLBACK ONLY: how long (seconds) the agent connection must stay
# stable — liveness present and no reconnect — before the worker begins
# dispatching provisioning, used when the deployed agent predates the
# system.boot_info probe. New agents are probed actively (uptime plus legacy
# finalize-task state), which reconnect churn can't stall. Must exceed the 90s
# agent liveness TTL plus the intermediate-boot window. Default 180 (3 min).
# AGENT_BOOT_SETTLE_S=180

# LEGACY-IMAGE RECOVERY ONLY: uptime (seconds) past which a still-registered
# FirstBootFinalize scheduled task is treated as having missed its -AtStartup
# trigger — the worker then dispatches system.reboot. Current single-reboot
# images do not create this task. Default 600 (10 min).
# AGENT_BOOT_FORCE_REBOOT_UPTIME_S=600

# Admin teardown console — how long a VM registry entry has to look wrong
# before it is flagged as orphaned. These only affect what an admin sees
# classified; nothing is ever destroyed without an explicit previewed
# selection. Default 86400 (24h) — a lab left running over a weekend is fine,
# one whose agent has been silent for a day is debris.
# TEARDOWN_AGENT_DEAD_AFTER_S=86400

# How long (seconds) a registry entry may sit in `cloning` after its last write
# before it counts as stuck. A real clone finishes or errors well inside this.
# Default 3600 (1h).
# TEARDOWN_STUCK_CLONING_AFTER_S=3600

# How long (seconds) an ESXi inventory listing is reused across the polled
# teardown endpoints — the listing walks the whole inventory, and the console
# polls. The destroy preview always reads fresh. Default 15.
# TEARDOWN_INVENTORY_CACHE_S=15

# --- Remote desktop (Apache Guacamole) ---------------------------------------
# Where guacd listens. guacd is Apache Guacamole's proxy daemon and the only
# Guacamole component this stack runs: there is no guacamole-client webapp, no
# second database, and no second set of accounts. The API speaks the Guacamole
# protocol to guacd itself and relays it to the browser over its own
# authenticated WebSocket, so the session token stays the only credential.
#
# Start it the same way Mongo is started on the host, bound to loopback (guacd
# performs no authentication of its own):
#   docker run -d --name guacd --restart unless-stopped \
#     -p 127.0.0.1:4822:4822 guacamole/guacd:1.5.5
#
# Unset or unreachable disables exactly one feature — the node Inspector's
# Remote Desktop panel reports the service as unavailable and everything else
# works. Defaults 127.0.0.1 / 4822.
# GUACD_HOST=127.0.0.1
# GUACD_PORT=4822

# Lifetime (seconds) of a console ticket — the single-use handoff between the
# HTTP route that authorizes a session and the WebSocket that opens it. The
# browser connects immediately; a longer window only makes a leaked ticket id
# more useful. Default 60.
# CONSOLE_TICKET_TTL_S=60

# Concurrent relayed remote-desktop sessions. Framebuffer traffic shares the
# API's event loop with every guest agent socket (a single uvicorn worker, on
# purpose), so this caps how much of that loop open desktops can take.
# Default 8.
# CONSOLE_MAX_SESSIONS=8

# How often (seconds) an idle session is nudged so a reverse proxy does not reap
# it. An unattended desktop sends no traffic and nginx's proxy_read_timeout
# defaults to 60s, which reads to the user as a session that died on its own.
# Default 20.
# CONSOLE_KEEPALIVE_S=20
